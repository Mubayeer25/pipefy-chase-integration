        print(pipefy_user_info)
        estr = f"get_user_id method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return 2507, estr, 106


def get_client_contact(contact_name):
    try:

        url = f"{get_chase_url()}/api/Contact/Search/{contact_name}"

        headers = {
            "ConfigID": configID,
        }

        response_obj = requests.get(
            url, auth=get_basic_auth(), headers=headers, timeout=20, verify=False
        )

        if response_obj.status_code == 200:
            if isinstance(response_obj.json(), list) and len(response_obj.json()) > 0:
                contact_id = response_obj.json()[0].get("ContactID")
                contact_email = response_obj.json()[0].get("Email")
            else:
                return None, None, "Chase get client contact status=200, No contact found"
        else:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return None, {}, error_message

        return contact_id, contact_email, "Chase get client number status=200,"
    except requests.exceptions.Timeout:
        # print("Took too long to respond")
        return None, "Chase took too long to respond, Probably a vpn issue", 108
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"get_client_contact method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return None, estr, 106


