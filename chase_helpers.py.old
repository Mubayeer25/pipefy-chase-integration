# Load configuration from the file
config = configparser.ConfigParser()
config.read("segredo.ini")

# Suppress SSL warnings (since you're using verify=False)
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

pipefy_api_url = config.get("Pipefy", "pipefy_api_url")
pipefy_api_token = config.get("Pipefy", "pipefy_api_token")

# SETUP PIPELIB
pipefy = Pipefy(pipefy_api_url, pipefy_api_token)

# Basic Auth credentials

timeout = 5  # Reduced from 10 seconds for faster responses
max_retry = 2  # Reduced retry attempts to fail faster

# Chase login details
# chase_username = None
# chase_password = None
test_state = False

def get_chase_url():
    return config.get("Chase", "CHASE_URL_TEST") if test_state else config.get("Chase", "CHASE_URL_PROD")

def get_chase_credentials():
    """Get the appropriate Chase credentials based on current test_state"""
    if test_state:
        username = "ross.holmes@theupandupgroup.com"
        password = ">.aiz){W"
    else:
        username = "ross.holmes@theupandupgroup.com"
        password = ">.aiz){W"
    return username, password

def get_basic_auth():
    """Get the appropriate basic auth object based on current test_state"""
    username, password = get_chase_credentials()
    return HTTPBasicAuth(username, password)

def get_current_environment_info():
    """Get debug information about current environment settings"""
    username, password = get_chase_credentials()
    return {
        "test_state": test_state,
        "environment": "QA" if test_state else "Live",
        "chase_url": get_chase_url(),
        "username": username,
        "password_length": len(password) if password else 0
    }

configID = "1"

# Create a session object
session = requests.Session()

# Define the retry strategy
retries = Retry(
    total=max_retry,  # Retry up to max_retry times
    backoff_factor=2,  # Delay between retries (1s, 2s, 4s, etc.)
    # status_forcelist=[500, 502, 503, 504],  # Only retry on these HTTP status codes
    allowed_methods=["GET"],  # Retry only GET requests
)

# Mount the adapter with the retry strategy to HTTPS requests
adapter = HTTPAdapter(max_retries=retries)
session.mount("https://", adapter)
session.mount("http://", adapter)

billing_categories = {
    "retainer:inscope": 428,
    "retainer:outofscope": 427,
    "project": 868,
}
oStamp = {}

tz = pytz.timezone("Africa/Johannesburg")

# Note: basic_auth is now generated dynamically via get_basic_auth() function


def create_job_bag(client_id, product_id, category_id, card_data):
    #####
    ## Creates a new job bag in Chase using provided client, product, and category IDs,
    ## along with card data from Pipefy.
    #####
    try:
        element = None
        campaign_year = card_data.get("campaign_year","")
        campaign_name = card_data.get("campaign_name")
        job_name = card_data.get("job_name", "")
        #####
        ## Year – Product – Product/Campaign name – Element descriptor
        ## For example:
        ## 2025 – Brand – Summer Campaign – OOH
        ## 2025 – MFS – Momo 1G – Digital
        #####
        print(f"campaign_year: {campaign_year}, campaign_name: {campaign_name}, job_name: {job_name}\n")
        if campaign_name is None:
            element = f"{campaign_year}-{job_name}"
        else:
            element = f"{campaign_year}-{campaign_name}-{job_name}"

        if len(element) > 100:
            element = element[:100]

        url = f"{get_chase_url()}/api/Job/AddNew?customerid={client_id}&productid={product_id}&element={element}&categoryid={category_id}"
        headers = {
            "ConfigID": configID,
        }

        response_obj = requests.post(
            url, auth=get_basic_auth(), headers=headers, timeout=timeout, verify=False
        )

        job_bag_id = response_obj.json()

        if response_obj.status_code != 200:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return {}, error_message, response_obj.status_code

        return (
            str(job_bag_id),
            "Chase create job bag status=200,",
            response_obj.status_code,
        )
    except requests.exceptions.Timeout:
        # print("Took too long to respond")
        return {}, "Chase took too long to respond, Probably a vpn issue", 108
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"create_job_bag method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return {}, estr, 106


def update_job_bag_notes(job_bag_obj, card_details, ostamp):
    #####
    ## Updates an existing job bag in Chase with new details from Pipefy.
    #####
    try:
        pipe_id = card_details["pipe_object"].get("id")
        current_board = card_details["pipe_object"].get("name")

        updated_notes = None
        card_url = card_details.get("card_url")
        
        # Get the current notes, or use an empty string if not present
        current_notes = job_bag_obj.get("Notes")
        # Prepare the new note to add
        new_note = f"{current_board} Card Link: {card_url}"
        # Combine with a newline if current_notes is not empty
        if current_notes:
            job_bag_obj["EstHours"] = None
            updated_notes = current_notes + f"<br>{new_note}"
        else:
            updated_notes = new_note
        
        if len(updated_notes) > 8000:
            updated_notes = updated_notes[:8000]

        job_bag_obj["Notes"] = updated_notes

        # print(f"current_notes:{current_notes},\n\n new_note:{new_note}, \n\n updated_notes: {job_bag_obj['Notes']}\n\n")
        # print(f"est hours: {job_bag_obj['EstHours']}")
        
        # updated_notes = f"Creative card <br><br> Production card <br><br> Media card <br><br> Social card <br><br> Account Management Card Link: {card_url}"
        
        # Assign the updated notes back to the job bag object

        url = f"{get_chase_url()}/api/Job/Update"

        update_headers = {
            "Content-Type": "application/json",
            "ConfigID": configID,
        }

        response_obj = requests.post(
            url,
            auth=get_basic_auth(),
            headers=update_headers,
            json=job_bag_obj,
            timeout=20,
            verify=False,
        )
        if response_obj:
            if response_obj.status_code != 200:
                # print(resp.text)
                error_message = response_obj.text
                if isinstance(response_obj, object):
                    response_json_obj = response_obj.json()
                    print(f"response_json_obj: {response_json_obj}")
                    if response_json_obj.get("error") and response_json_obj.get("message"):
                        error_message = (
                            response_json_obj.get("error")
                            + ": "
                            + response_json_obj.get("message")
                        )
                    elif response_json_obj.get("error") and not response_json_obj.get(
                        "message"
                    ):
                        error_message = response_json_obj.get("error")
                return {}, error_message, response_obj.status_code
        
            return True, "Chase update Job Bag Notes status=200", response_obj.status_code
        else:
            return {}, f"Chase update Job Bag Notes failed", 108

    except requests.exceptions.Timeout:
        # print("Took too long to respond")
        return {}, "Chase took too long to respond, Probably a vpn issue", 108
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"update_job_bag_notes method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return {}, estr, 106
    
def get_client_id(client_name):
    #####
    ## Retrieves the client ID from Chase based on the provided client name.
    #####
    oStamp["time"] = datetime.now(tz).strftime("%Y:%m:%d %H:%M:%S")
    response_obj = None
    try:

        url = f"{get_chase_url()}/api/Client/Search/{client_name}"
        headers = {
            "ConfigID": configID,
        }

        response_obj = session.get(
            url,
            auth=get_basic_auth(),  # Basic Auth
            headers=headers,  # Custom headers
            verify=False,  # Disable SSL verification (use True in production)
            timeout=timeout,  # Timeout in seconds
        )

        # response_obj = requests.get(url, auth=basic_auth, headers=headers, timeout=20, verify=False)

        # client_id = "70570"
        if response_obj.status_code == 200:
            if isinstance(response_obj.json(), list) and len(response_obj.json()) > 0:
                client_id = str(response_obj.json()[0].get("ClientID"))
            else:
                return {}, "Chase client not found", 108
        else:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return {}, error_message, response_obj.status_code

        return client_id, "Chase get client status=200,", response_obj.status_code
    except ValueError as e:
        # Handle the ValueError specifically for client ID index issue
        e_type, e_object, e_traceback = sys.exc_info()
        error_message = f"ERROR line {e_traceback.tb_lineno}: error message => {str(e)}. response_obj: {response_obj.text}"
        return {}, error_message, 108
    except requests.exceptions.RequestException as e:
        # Catch all requests-related exceptions
        # e.add_note(response_obj.status_code)
        resp_obj, status_code = general_helpers.fnLogToPapertrail(oStamp, e)
        return {}, "Chase took too long to respond, Probably a vpn issue", e
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"get_client_id method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return {}, estr, 106

    finally:
        session.close()


def get_product_id(product_name, client_id):
    #####
    ## Retrieves the product ID from Chase based on the provided product name and client ID.
    #####
    product_details = {}
    # product_id = 4452
    try:

        url = f"{get_chase_url()}/api/Product/CustomerID/{client_id}"

        headers = {
            "ConfigID": configID,
        }

        response_obj = session.get(
            url,
            auth=get_basic_auth(),  # Basic Auth
            headers=headers,  # Custom headers
            verify=False,  # Disable SSL verification (use True in production)
            timeout=timeout,  # Timeout in seconds
        )

        if response_obj.status_code != 200:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return {}, error_message, response_obj.status_code

        if product_name == "Mobile Fintech SA":
            product_name = "Mobile Fintech SA (Pty) Ltd"

        if response_obj.status_code == 200:
            product_list = response_obj.json()

            # print(f"product_list: {product_list}")
            for product in product_list:
                # print(f"product: {product.get("ProductName").lower()}, product_name: {product_name.lower()}, does it match: {product.get("ProductName").lower().replace("–", "-") == product_name.lower().replace("–", "-")} \n")
                if product.get("ProductName").strip().lower().replace("–", "-").replace(" ", "") == product_name.strip().lower().replace("–", "-").replace(" ", ""):
                    product_details["product_id"] = product.get("ProductID")
                    product_details["product_contact"] = product.get("ContactName")
                    # print(f"product_details: {product_details} \n")
                    break
        
        # general_helpers.fnLogToPapertrail(oStamp,f"get_product_id product details: {product_details}\n")
        
        return product_details, "Chase get product status=200,", response_obj.status_code
    except requests.exceptions.RequestException as e:
        # Catch all requests-related exceptions
        resp_obj, status_code = general_helpers.fnLogToPapertrail(oStamp, e)
        print(f"Exception in get_product_id: {e}")
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"get_product_id method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        print(estr)
        return {}, estr, 106
    finally:
        session.close()


def get_business_unit_id(business_unit):
    business_unit_id = None
    # product_id = 4452
    try:

        url = f"{get_chase_url()}/api/BusinessUnit"

        headers = {
            "ConfigID": configID,
        }

        response_obj = session.get(
            url,
            auth=get_basic_auth(),  # Basic Auth
            headers=headers,  # Custom headers
            verify=False,  # Disable SSL verification (use True in production)
            timeout=timeout,  # Timeout in seconds
        )

        if response_obj.status_code == 200:
            unit_list = response_obj.json()

            for business in unit_list:
                if business.get("BusinessUnit") == business_unit:
                    business_unit_id = business.get("BusinessUnitID")
                    break

        if response_obj.status_code != 200:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return {}, error_message, response_obj.status_code

        return (
            business_unit_id,
            "Chase get business unit id status=200,",
            response_obj.status_code,
        )
    except requests.exceptions.RequestException as e:
        # print("Took too long to respond")
        return {}, "Chase took too long to respond, Probably a vpn issue", 108
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"get_business_unit_id method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return {}, estr, 106
    finally:
        session.close()


