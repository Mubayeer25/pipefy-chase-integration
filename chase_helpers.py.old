def get_job_category_id(brief_type, element, other_element, pipe_name, selected_channel, selected_retail_element):
    oStamp["time"] = datetime.now(tz).strftime("%Y:%m:%d %H:%M:%S")
    oStamp["cardid"] = 12345678
    
    # general_helpers.fnLogToPapertrail(oStamp,f"category details: '{brief_type}', '{element}', '{other_element}', '{selected_retail_element}'\n")
    
    category_id = None
    element_lower = None
    mapped_category = None
    # retail_element_category = None
    
    try:
        if selected_retail_element is not None:
            retail_element_category = selected_retail_element.strip().lower().replace("/", "").replace("  ", "_").replace(" ", "_")
        # product_id = 4452
        # if this is an element card then we need to pull the corresponding category for the element from the category_map
        if element is not None:
            element_lower = element.replace(" ", "").lower()
        
        if brief_type == "Integrated" or brief_type == "Toolkit":
            mapped_category = "TTL"
        elif brief_type == "PR":
            mapped_category = "PR/Press"
        elif brief_type == "Production only":
            mapped_category = "Production"
        elif brief_type == "Media":
            mapped_category = "Media"
        elif brief_type == "Social":
            mapped_category = "Social Media"
        elif brief_type == "Internal communications":
            mapped_category = "BTL"
        elif pipe_name == "Account Management" and element is None:
            # get the category name from the category_map for the element
            if brief_type == "Retail":
                mapped_category = "BTL"
            else:
                mapped_category = brief_type
        elif element is not None or other_element is not None:
            if selected_channel == "Internal Marketing":
                brief_type = "Digital"
            if other_element is not None:
                mapped_category = brief_type
                if brief_type == "Retail":
                    mapped_category = "BTL"
            elif brief_type in category_map:
                sub_category = category_map[brief_type]
                if brief_type == "Retail":
                    mapped_category = sub_category.get(retail_element_category, {}).get(element_lower)
                else:
                    mapped_category = sub_category.get(element_lower, brief_type)
        else:
            mapped_category = brief_type
            if brief_type == "Retail" or brief_type == "Internal communications":
                mapped_category = "BTL"

        # general_helpers.fnLogToPapertrail(oStamp,f"category details: '{brief_type}', '{mapped_category}', '{element_lower}', '{other_element}', '{selected_retail_element}'\n")

        # message = (
        #     f"brief_type: {brief_type}, mapped_category: {mapped_category}, element_lower: {element_lower}\n\n"
        # )
        # resp_obj, status_code = general_helpers.fnLogToPapertrail({}, message)

        url = f"{get_chase_url()}/api/Lists/GetJobCategories"

        headers = {
            "ConfigID": configID,
        }

        response_obj = requests.get(
            url, auth=get_basic_auth(), headers=headers, timeout=20, verify=False
        )

        if response_obj.status_code == 200:
            category_list = response_obj.json()

            for category in category_list:
                if category.get("CategoryName") == mapped_category:
                    category_id = category.get("CategoryID")
                    break
                else:
                    category_id = None

        if response_obj.status_code != 200:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return {}, error_message, response_obj.status_code

        return category_id, "Chase get category status=200,", response_obj.status_code
    except requests.exceptions.Timeout:
        # print("Took too long to respond")
        return {}, "Chase took too long to respond, Probably a vpn issue", 108
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"get_category_id method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return {}, estr, 106


def get_job_required_fields(job_bag_id):
    job_bag_data = None
    try:

        url = f"{get_chase_url()}/api/Job/RequiredFields/{job_bag_id}"

        headers = {
            "ConfigID": configID,
        }

        response_obj = requests.get(
            url, auth=get_basic_auth(), headers=headers, timeout=20, verify=False
        )

        if response_obj.status_code == 200:
            if isinstance(response_obj.json(), list) and len(response_obj.json()) > 0:
                job_bag_data = response_obj.json()[0]
                return (
                    job_bag_data,
                    "Chase get job bag status=200,",
                    response_obj.status_code,
                )
            else:
                return {}, "Chase get job bag status=200, No job bag found", 108
        else:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return {}, error_message, response_obj.status_code

    except requests.exceptions.Timeout:
        # print("Took too long to respond")
        return {}, "Chase took too long to respond, Probably a vpn issue", 108
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = f"get_job_required_fields method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        return {}, estr, 106


def update_required_fields(job_bag_obj, card_details, card_id, client_contact_id, ostamp):
    try:
        # Parse the input date into a datetime object
        if (card_details.get("trafficker") is None or "") or (card_details.get("account_manager") is None or ""):
            card_details, message, status_code = pipefy.get_card_details(card_id)
            general_helpers.fnLogToPapertrail(ostamp, f"Trafficker or AM not found, fetching card details again")

        pipe_id = card_details["pipe_object"].get("id")
        job_deadline = card_details.get("job_deadline")
        go_live_date = card_details.get("go_live_date")
        trafficker = card_details.get("trafficker")
        account_manager = card_details.get("account_manager")
        if job_deadline is None:
            job_deadline = go_live_date
            job_date_obj = datetime.strptime(job_deadline, "%d/%m/%Y")
        else:
            job_date_obj = datetime.strptime(job_deadline, "%d/%m/%Y %H:%M")
        
        
        if go_live_date is not None:
            media_date_obj = datetime.strptime(go_live_date, "%d/%m/%Y")
            formatted_media_date = (
                media_date_obj.strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "+02:00"
            )
            job_bag_obj["StartDate"] = formatted_media_date

        # Convert the datetime object to the desired ISO 8601 format with timezone offset
        formatted_job_date = (
            job_date_obj.strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "+02:00"
        )
        
        # print(f"trafficker: {trafficker}, type: {type(trafficker)} \n")

        # Try to parse as JSON list first
        trafficker_list = []
        if isinstance(trafficker, str):
            s = trafficker.strip()
            if s.startswith("[") and s.endswith("]"):
                try:
                    trafficker_list = json.loads(s)
                except Exception:
                    # fallback: split by comma
                    trafficker_list = [name.strip(' "\'') for name in s[1:-1].split(",")]
            elif "," in s:
                trafficker_list = [name.strip(' "\'') for name in s.split(",")]
            elif s:
                trafficker_list = [s.strip(' "\'')]
        elif isinstance(trafficker, list):
            trafficker_list = trafficker
        elif trafficker is not None:
            trafficker_list = [str(trafficker)]

        account_manager_list = []
        if isinstance(account_manager, str):
            s = account_manager.strip()
            if s.startswith("[") and s.endswith("]"):
                try:
                    account_manager_list = json.loads(s)
                except Exception:
                    # fallback: split by comma
                    account_manager_list = [name.strip(' "\'') for name in s[1:-1].split(",")]
            elif "," in s:
                account_manager_list = [name.strip(' "\'') for name in s.split(",")]
            elif s:
                account_manager_list = [s.strip(' "\'')]
        elif isinstance(account_manager, list):
            account_manager_list = account_manager
        elif account_manager is not None:
            account_manager_list = [str(account_manager)]

        print(f"trafficker_list: {trafficker_list}")
        
        # Initialize IDs to None
        trafficker_id = None
        account_manager_id = None
        
        if trafficker_list:
            trafficker_id, error_message, status_code = get_user_id(trafficker_list[0], pipe_id)
        if account_manager_list:
            account_manager_id, error_message, status_code = get_user_id(account_manager_list[0], pipe_id)
        elif trafficker_list is None and account_manager_list:
            trafficker_id, error_message, status_code = get_user_id(account_manager_list[0], pipe_id)
            general_helpers.fnLogToPapertrail(ostamp, f"Trafficker not found, defaulting to {account_manager_list[0]}, trafficker value: {trafficker}")
        else:
            trafficker_id, error_message, status_code = get_user_id("Ross Holmes", pipe_id)
            general_helpers.fnLogToPapertrail(ostamp, f"Trafficker not found, defaulting to Ross Holmes, trafficker value: {trafficker}")

        if trafficker_id is None:
            trafficker_id = 2507  # Default to a known user ID if not found
            general_helpers.fnLogToPapertrail(ostamp, f"Trafficker not found, defaulting to Ross Holmes, account manager value: {account_manager_list}")
        if account_manager_id is None:
            account_manager_id = 2507  # Default to a known user ID if not found
            general_helpers.fnLogToPapertrail(ostamp, f"Account Manager not found, defaulting to Ross Holmes, account manager value: {account_manager}")

        print(f"account_manager_id: {account_manager_id}, account_manager: {account_manager_list[0] if account_manager_list else 'None'}\n")

        division_id = card_details.get("division_id")
        job_bag_fields = {
            "BusinessUnitID": 11,
            "DeliveryDate": formatted_job_date,
            "TrafficUserID": trafficker_id,
        }

        job_bag_obj["UserID"] = account_manager_id

        # Check and assign the billing category
        billing_category = card_details.get("billing_category")
        if billing_category is not None:
            billing_category = billing_category.replace(" ", "").lower()
            category_id = billing_categories.get(billing_category)
            if category_id is None:
                # If the billing category is not found in the dictionary, set a default value or handle the error
                category_id = 453
            job_bag_obj["BillingCategoryID"] = category_id
        else:
            job_bag_obj["BillingCategoryID"] = 453

        # message = f"Billing Category: {billing_category}, Billing category ID: {job_bag_obj['BillingCategoryID']}"
        # resp_obj, status_code = general_helpers.fnLogToPapertrail(ostamp, message)
        # Update fields in job_bag_obj with the remainging fields
        for key, value in job_bag_fields.items():
            if key in job_bag_obj:
                job_bag_obj[key] = value

        # get the parent job bag id from the parent job number
        if card_details.get("parent_job_number") is not None:
            parent_job_bag_obj, error_message, status_code = get_job_by_number(
                card_details.get("parent_job_number")
            )
            parent_job_bag_id = parent_job_bag_obj.get("JobID")
            job_bag_obj["ParentJobID"] = parent_job_bag_id

        # add the last remaing fields to the job bag object
        if client_contact_id is not None:
            job_bag_obj["ContactID"] = client_contact_id

        print(f"job_bag_obj: {job_bag_obj} \n")

        # print(f"division_id: {division_id} \n")
        
        if division_id is not None:
            job_bag_obj["DivisionID"] = division_id
        
        # message = f"product: {division_id}, job_bag_obj: {job_bag_obj}, card_details: {card_details}"
        # resp_obj, status_code = general_helpers.fnLogToPapertrail(oStamp, message)

        url = f"{get_chase_url()}/api/Job/UpdateSpecificFields"

        headers = {
            "Content-Type": "application/json",
            "ConfigID": configID,
        }

        response_obj = requests.post(
            url,
            auth=get_basic_auth(),
            headers=headers,
            json=job_bag_obj,
            timeout=20,
            verify=False,
        )

        if response_obj.status_code != 200:
            # print(resp.text)
            error_message = response_obj.text
            if isinstance(response_obj, object):
                response_json_obj = response_obj.json()
                print(f"required job bag response_json_obj: {response_json_obj}")
                if response_json_obj.get("error") and response_json_obj.get("message"):
                    error_message = (
                        response_json_obj.get("error")
                        + ": "
                        + response_json_obj.get("message")
                    )
                elif response_json_obj.get("error") and not response_json_obj.get(
                    "message"
                ):
                    error_message = response_json_obj.get("error")
            return {}, error_message, response_obj.status_code

        print(f"response_obj for update specific fields: {response_obj} \n")
        return True, "Chase update Job Bag status=200", 200

    except requests.exceptions.Timeout:
        # print("Took too long to respond")
        return {}, "Chase took too long to respond, Probably a vpn issue", 108
    except Exception as e:  ## EXCEPTION MUST BE THE LAST HANDLER
        e_type, e_object, e_traceback = sys.exc_info()
        estr = {}
        estr["message"] = (
            f"update_required_fields method returned exception ERROR line {e_traceback.tb_lineno}: error message => {str(e)}."
        )
        estr["job_bag_obj"] = job_bag_obj
        estr["card_details"] = card_details
        general_helpers.fnLogToPapertrail(oStamp, estr)
        return {}, estr, 106
